# Postgres (Neon or Supabase). Phase 1 onwards.
DATABASE_URL=

# Encrypts the X tokens held in `connections` so a leaked database dump is not
# a live key to the account. Required whenever DATABASE_URL is set: crypto.ts
# refuses to write a token in the clear without it.
# It does NOT fail loudly. The refusal is thrown inside events.signIn, and
# @auth/core wraps every event method in a handler that logs and swallows, so
# sign-in still appears to succeed with no `connections` row written. Never
# read a successful sign-in as proof the token was stored.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Auth.js v5 — X provider, OAuth 2.0 PKCE.
# Scopes: bookmark.read tweet.read users.read offline.access
# Callback URL registered in the X developer console — the deployed one only:
#   https://commonplace-livid.vercel.app/api/auth/callback/twitter
# X's portal refused an http://localhost callback, so sign-in works at the
# production alias and nowhere else. Local dev and Vercel preview URLs both
# mismatch, since the callback host is derived from the request.
AUTH_SECRET=
AUTH_X_ID=
AUTH_X_SECRET=

# The spend guard. Bookmark reads bill per resource, so sign-in is refused for
# every X account but this one — a numeric user id, not a handle. Unset means
# nobody can connect, which is the safe default rather than an oversight.
X_ALLOWLIST_USER_ID=

# Pages of 100 bookmarks one POST /api/sync may walk. The second guard on
# spend: 20 covers a ~1,300-bookmark backfill with room to spare. If a run
# comes back with a resumeToken, it stopped here and there is more to read.
SYNC_MAX_PAGES=20

# Phase 2 onwards.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Phase 3 — the brief goes out as plain text.
RESEND_API_KEY=
